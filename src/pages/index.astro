---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkStack from '../components/WorkStack.astro';
import { visibleProjects } from '../lib/visibility';

const projects = await visibleProjects();
const hasWork = projects.some((p) => p.data.featured);
const nav = hasWork ? [{ href: '#work', label: 'Work' }] : [];
---

<Base title="Nicolò Boni, developer and designer" description="Nicolò Boni designs and builds websites and web apps, and makes motion pieces on the side.">
  <Hero nav={nav} />
  <main id="main">
    <WorkStack projects={projects} />
  </main>
</Base>
